<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Iska" targetNamespace="http://iska.example/bpmn">
  <bpmn:collaboration id="Collab_Iska">
    <bpmn:participant id="P_PROV" name="Proveedor de insumos" />
    <bpmn:participant id="P_ISKA" name="Microcervecería Iska" processRef="Proc_Lote" />
    <bpmn:participant id="P_CLI" name="Cliente (pub / bar)" />
    <bpmn:messageFlow id="m1" name="Orden de compra" sourceRef="T3" targetRef="P_PROV" />
    <bpmn:messageFlow id="m2" name="Insumos + remito" sourceRef="P_PROV" targetRef="T4" />
    <bpmn:messageFlow id="m3" name="Aviso de stock disponible" sourceRef="T13" targetRef="P_CLI" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Lote" name="Elaboración, control de fermentación y liberación de un lote" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="L_ADM" name="Administración y Compras">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_MC" name="Maestro Cervecero">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_OP" name="Asistente / Operario">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SYS" name="Sistema ISKA (automatizado)">
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IE1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Inicio semanal de producción">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_1"><bpmn:timeCycle>R/P1W</bpmn:timeCycle></bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Planificar lote y seleccionar receta">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G0" name="">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T2" name="Verificar stock de insumos de la receta">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="¿Stock suficiente?">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Aprobar y enviar orden de compra">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="T4" name="Recibir insumos y registrar ingreso">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:manualTask id="T5" name="Elaborar mosto (maceración, cocción)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T6" name="Crear lote y descontar insumos del stock">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T7" name="Registrar temperatura del fermentador">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="¿Temp. en rango?">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="IE1" name="Alarma">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_1" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="T9" name="Corregir temperatura / revisar equipo">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4" name="¿Fermentación completa?">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T10" name="Tomar muestra y analizar color y turbidez">
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5" name="¿Lote aprobado?">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T11" name="Registrar lote como Rechazado">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="Lote descartado">
      <bpmn:incoming>f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="T12" name="Embotellar y etiquetar">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="T13" name="Liberar lote y actualizar stock">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Lote listo para la venta">
      <bpmn:incoming>f24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="S1" targetRef="T1" />
    <bpmn:sequenceFlow id="f2" sourceRef="T1" targetRef="G0" />
    <bpmn:sequenceFlow id="f3" sourceRef="G0" targetRef="T2" />
    <bpmn:sequenceFlow id="f4" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="f5" name="No" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="f6" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="f7" sourceRef="T4" targetRef="G0" />
    <bpmn:sequenceFlow id="f8" name="Sí" sourceRef="G1" targetRef="T5" />
    <bpmn:sequenceFlow id="f9" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="f10" sourceRef="T6" targetRef="G2" />
    <bpmn:sequenceFlow id="f11" sourceRef="G2" targetRef="T7" />
    <bpmn:sequenceFlow id="f12" sourceRef="T7" targetRef="G3" />
    <bpmn:sequenceFlow id="f13" name="No" sourceRef="G3" targetRef="IE1" />
    <bpmn:sequenceFlow id="f14" sourceRef="IE1" targetRef="T9" />
    <bpmn:sequenceFlow id="f15" sourceRef="T9" targetRef="G2" />
    <bpmn:sequenceFlow id="f16" name="Sí" sourceRef="G3" targetRef="G4" />
    <bpmn:sequenceFlow id="f17" name="No (sigue)" sourceRef="G4" targetRef="G2" />
    <bpmn:sequenceFlow id="f18" name="Sí" sourceRef="G4" targetRef="T10" />
    <bpmn:sequenceFlow id="f19" sourceRef="T10" targetRef="G5" />
    <bpmn:sequenceFlow id="f20" name="No" sourceRef="G5" targetRef="T11" />
    <bpmn:sequenceFlow id="f21" sourceRef="T11" targetRef="E2" />
    <bpmn:sequenceFlow id="f22" name="Sí" sourceRef="G5" targetRef="T12" />
    <bpmn:sequenceFlow id="f23" sourceRef="T12" targetRef="T13" />
    <bpmn:sequenceFlow id="f24" sourceRef="T13" targetRef="E1" />
  </bpmn:process>
